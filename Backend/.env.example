# ---------------------------------------------------------------------------
# TechnoDirect dashboard backend configuration.
# Any value containing REPLACE_ME is treated as "not configured":
#   * DATABASE_URL unset/placeholder  -> local SQLite (db.sqlite3)
#   * REDIS_URL unset/placeholder     -> in-process cache + Celery eager mode
#   * connector creds placeholder     -> that sync records status "not_configured"
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=REPLACE_ME
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
TIME_ZONE=Asia/Kolkata
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Data refresh times (IST, 24h, comma-separated). All sources sync in one chained job.
SYNC_TIMES=10:00,18:00

# --- Warehouse (AWS RDS PostgreSQL) ----------------------------------------
# e.g. postgres://td_app:PASSWORD@td-warehouse.xxxxxx.ap-south-1.rds.amazonaws.com:5432/td_warehouse
DATABASE_URL=REPLACE_ME

# --- TD data live from Supabase (orders, sales, customers, ...; READ-ONLY login) ---
# TD data comes only from Supabase, refreshed automatically at SYNC_TIMES (10:00 / 18:00 IST).
# Setup: run deploy/supabase_readonly.sql in Supabase > SQL Editor (creates td_dashboard_ro), then copy these from
# Supabase > Connect > Session pooler > "View parameters". Test with: python manage.py supabase_check
SUPABASE_DB_HOST=REPLACE_ME_aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# pooler user = role name + "." + your project ref, e.g. td_dashboard_ro.abcdefghijklmnop
SUPABASE_DB_USER=REPLACE_ME_td_dashboard_ro.PROJECT_REF
SUPABASE_DB_PASSWORD=REPLACE_ME_password_set_in_supabase_readonly_sql
SUPABASE_DB_SSLMODE=require

# --- Dashboard edits kept in Supabase (users, targets, ASMs, handovers, mappings) ---
# Run deploy/supabase_edits.sql in Supabase > SQL Editor (creates schema "dashboard" + login td_dashboard_rw), then fill
# these in (same host as above). Edits are then backed up within seconds and restored automatically on a new server.
SUPABASE_EDITS_USER=REPLACE_ME_td_dashboard_rw.PROJECT_REF
SUPABASE_EDITS_PASSWORD=REPLACE_ME_password_set_in_supabase_edits_sql
# Stock shown on the dashboard: td = app stock from the TD database, ck = Channel Konnect
INVENTORY_PRIMARY_SOURCE=td

# --- Redis (ElastiCache) â€“ cache + Celery broker ---------------------------
# e.g. redis://td-redis.xxxxxx.cache.amazonaws.com:6379/0
REDIS_URL=REPLACE_ME

# --- PayU (sales / order transactions only) --------------------------------
PAYU_MERCHANT_KEY=REPLACE_ME
PAYU_MERCHANT_SALT=REPLACE_ME
PAYU_BASE_URL=https://info.payu.in
# Only needed if switching to PayU OAuth-based APIs
PAYU_CLIENT_ID=REPLACE_ME
PAYU_CLIENT_SECRET=REPLACE_ME

# --- Google Sheets (CRM complaint tracker) ---------------------------------
# key file of the Google service account (live sheets + CRM tracker); keep it outside the project folder
GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_ME_path_to_service_account.json
CRM_SHEET_ID=REPLACE_ME
CRM_SHEET_TAB=

# --- Channel Konnect (distributor stock) -----------------------------------
CK_BASE_URL=REPLACE_ME
CK_API_KEY=REPLACE_ME

# --- Bootstrap master admin (manage.py create_master_admin) ----------------
MASTER_ADMIN_EMAIL=REPLACE_ME
MASTER_ADMIN_PASSWORD=REPLACE_ME

# --- Login OTP email (Gmail / Google Workspace SMTP) ---------------------------
# After the password step a 6-digit code is emailed; the dashboard opens only once it is entered.
# EMAIL_HOST_USER     = the Gmail / Workspace address that sends the codes
# EMAIL_HOST_PASSWORD = a 16-character Google App Password for that account (NOT its normal password):
#                       Google Account > Security > 2-Step Verification (must be on) > App passwords
# While these are REPLACE_ME and DEBUG=True, the email with the code is printed in the backend console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
DEFAULT_FROM_EMAIL=REPLACE_ME
LOGIN_OTP_ENABLED=True
LOGIN_OTP_TTL_MINUTES=5
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_SECONDS=30

# --- Techno AI assistant (Ollama) -------------------------------------------------
# Ollama Cloud: OLLAMA_BASE_URL=https://ollama.com, an API key from https://ollama.com/settings/keys and a cloud
#               model (e.g. gpt-oss:120b, qwen3-coder:480b, deepseek-v3.1:671b).
# Self-hosted:  OLLAMA_BASE_URL=http://localhost:11434, OLLAMA_API_KEY empty, a pulled model (e.g. llama3.1:8b).
# Restart the backend after changing these.
ASSISTANT_ENABLED=True
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=REPLACE_ME
OLLAMA_MODEL=REPLACE_ME
OLLAMA_TIMEOUT=90
OLLAMA_NUM_CTX=16384
ASSISTANT_RATE_LIMIT=15/min

# BlueOrigin sheets from a local folder - optional, only if NOT using the Dropbox API below
# BLUEORIGIN_DIR=REPLACE_ME_path_to_BlueOrigin_folder
# Settlement tracker + TechnoD Distributors sheet: no file on this PC is read. They come from their copy in Supabase
# (schema reference: settlement_tracker, distributor_sync - refresh with `manage.py reference_sheet upload <name> <csv>`)
# until the live Google Sheet links below are set; then the dashboard reads the sheets itself at every refresh. The
# links need GOOGLE_SERVICE_ACCOUNT_JSON (path to the key file) and each sheet shared (Viewer) with that account's email.
SETTLEMENT_SHEET_URL=REPLACE_ME_https://docs.google.com/spreadsheets/d/.../edit#gid=...
DISTRIBUTOR_SYNC_SHEET_URL=REPLACE_ME_https://docs.google.com/spreadsheets/d/.../edit#gid=...

# --- BlueOrigin live from Dropbox (API) ---------------------------------------
# When all three are filled in, the BlueOrigin sheets are downloaded from Dropbox at every refresh and
# BLUEORIGIN_DIR is no longer used. Setup (Dropbox App Console, https://www.dropbox.com/developers/apps):
#   Create app > Scoped access > Full Dropbox; Permissions tab: tick files.metadata.read + files.content.read, Submit
#   Settings tab: copy App key + App secret below, then run  python manage.py dropbox_auth  (it saves the token)
DROPBOX_APP_KEY=REPLACE_ME_dropbox_app_key
DROPBOX_APP_SECRET=REPLACE_ME_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=REPLACE_ME_filled_in_by_manage_py_dropbox_auth
# the folder as Dropbox shows it (not the PC path)
DROPBOX_BO_PATH=/Power BI
